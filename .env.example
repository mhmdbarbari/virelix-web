# Contact form endpoint (JSON POST, e.g. Formspree). Empty = opens the email app.
VITE_CONTACT_ENDPOINT=
# Chat assistant endpoint. Empty = demo mode. On Vercel: /api/chat (and set ANTHROPIC_API_KEY).
VITE_CHAT_ENDPOINT=
# Website check (/check) works without keys. Optional, server side: Google PageSpeed key to add Lighthouse scores.
PSI_KEY=
# Only for static hosting without /api: browser fallback to Google (shared quota is often busy).
VITE_PSI_KEY=
